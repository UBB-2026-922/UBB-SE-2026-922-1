@model BankingApp.Web.ViewModels.RecurringPayments.CreateRecurringPaymentViewModel
@using BankingApp.Domain.Enums
@{
    ViewData["Title"] = "New Recurring Payment";
}

<div class="page-header">
    <a asp-action="Index" class="text-muted-sm text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>Back to recurring payments
    </a>
    <h1 class="page-title mt-2"><i class="bi bi-arrow-repeat me-2 text-primary"></i>New Recurring Payment</h1>
    <p class="page-subtitle">Schedule an automatic payment that repeats on your chosen frequency.</p>
</div>

<div class="form-card">
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="SelectedBillerId" class="form-label">
                        <i class="bi bi-building me-1"></i>Biller
                    </label>
                    <select asp-for="SelectedBillerId"
                            asp-items="Model.BillerSelectList"
                            class="form-select">
                        <option value="0">— Select a biller —</option>
                    </select>
                    <span asp-validation-for="SelectedBillerId" class="invalid-feedback d-block"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SelectedSourceAccountId" class="form-label">
                        <i class="bi bi-bank me-1"></i>Source Account
                    </label>
                    <select asp-for="SelectedSourceAccountId"
                            asp-items="Model.AccountSelectList"
                            class="form-select">
                        <option value="0">— Select an account —</option>
                    </select>
                    <span asp-validation-for="SelectedSourceAccountId" class="invalid-feedback d-block"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Amount" class="form-label">
                        <i class="bi bi-currency-dollar me-1"></i>Amount
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Amount" class="invalid-feedback d-block"></span>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input asp-for="IsPayInFull" class="form-check-input" type="checkbox" />
                        <label asp-for="IsPayInFull" class="form-check-label"></label>
                    </div>
                    <div class="form-text text-muted-sm">
                        When enabled, the full outstanding balance is paid instead of the fixed amount above.
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Frequency" class="form-label">
                        <i class="bi bi-calendar3 me-1"></i>Frequency
                    </label>
                    <select asp-for="Frequency"
                            asp-items="Html.GetEnumSelectList<RecurringFrequency>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Frequency" class="invalid-feedback d-block"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="StartDate" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>Start Date
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EndDate" class="form-label">
                                <i class="bi bi-calendar-x me-1"></i>End Date (optional)
                            </label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="invalid-feedback d-block"></span>
                            <div class="form-text text-muted-sm">
                                Leave blank for an indefinite schedule.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Create Recurring Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
