@model BankingApp.Web.Models.BillPayments.BillPayViewModel
@{
    ViewData["Title"] = "Pay a Bill";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-receipt me-2 text-primary"></i>Pay a Bill</h1>
        <p class="page-subtitle">Choose a biller, enter an amount and preview the fee before confirming.</p>
    </div>
    <a asp-action="History" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-clock-history me-1"></i>Payment History
    </a>
</div>

<div class="row g-4">

    <div class="col-lg-5 col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-bookmark-heart text-primary"></i>
                <span>Saved Billers</span>
                <span class="badge bg-primary ms-auto">@Model.SavedBillers.Count</span>
            </div>
            <div class="card-body p-2">
                @if (!Model.SavedBillers.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-bookmark-plus fs-2 text-muted"></i>
                        <p class="text-muted mt-2 mb-0 small">No saved billers yet.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush saved-billers-list" id="savedBillersList">
                        @foreach (var biller in Model.SavedBillers)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action saved-biller-item py-3 px-3"
                                    data-biller-id="@biller.BillerId"
                                    data-biller-ref="@biller.DefaultReference"
                                    title="Click to pre-fill the form">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(biller.LogoUrl))
                                    {
                                        <img src="@biller.LogoUrl" alt="@biller.DisplayName"
                                             class="rounded" width="36" height="36"
                                             style="object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="biller-icon-placeholder rounded d-flex align-items-center justify-content-center"
                                             style="width:36px;height:36px;background:var(--ba-surface);">
                                            <i class="bi bi-building text-primary"></i>
                                        </div>
                                    }
                                    <div class="flex-grow-1 text-start overflow-hidden">
                                        <div class="fw-600 text-truncate small">@biller.DisplayName</div>
                                        <div class="text-muted-sm text-truncate">@biller.DisplayCategory</div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7 col-xl-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-send text-primary"></i>
                <span>Payment Details</span>
            </div>
            <div class="card-body">

                <form asp-action="Preview" method="post" id="billPayForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Biller -->
                    <div class="form-group">
                        <label asp-for="SelectedBillerId" class="form-label">
                            <i class="bi bi-building me-1"></i>Biller
                        </label>
                        <select asp-for="SelectedBillerId"
                                asp-items="Model.BillerSelectList"
                                class="form-select"
                                id="billerSelect">
                            <option value="0">— Select a biller —</option>
                        </select>
                        <span asp-validation-for="SelectedBillerId" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Source account -->
                    <div class="form-group">
                        <label asp-for="SelectedAccountId" class="form-label">
                            <i class="bi bi-bank me-1"></i>From Account
                        </label>
                        <select asp-for="SelectedAccountId"
                                asp-items="Model.AccountSelectList"
                                class="form-select">
                            <option value="0">— Select an account —</option>
                        </select>
                        <span asp-validation-for="SelectedAccountId" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Biller reference -->
                    <div class="form-group">
                        <label asp-for="BillerReference" class="form-label">
                            <i class="bi bi-hash me-1"></i>Biller Reference / Account Number
                        </label>
                        <input asp-for="BillerReference"
                               class="form-control"
                               id="billerRef"
                               placeholder="e.g. INV-00123 or your customer number"
                               autocomplete="off" />
                        <span asp-validation-for="BillerReference" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Amount -->
                    <div class="form-group">
                        <label asp-for="Amount" class="form-label">
                            <i class="bi bi-currency-dollar me-1"></i>Amount
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Amount"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   id="amountInput"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="invalid-feedback d-block"></span>

                        <!-- Live fee preview hint -->
                        <div class="mt-2 small text-muted" id="feeHint" style="display:none;">
                            <i class="bi bi-info-circle me-1"></i>
                            Estimated fee: <strong id="feeHintValue"></strong>
                            <span id="twoFaHint" class="ms-2 text-warning" style="display:none;">
                                <i class="bi bi-shield-lock me-1"></i>2FA required
                            </span>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <button type="submit" class="btn btn-primary btn-full" id="previewBtn">
                        <i class="bi bi-eye me-2"></i>Preview Payment
                    </button>
                </form>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.saved-biller-item').forEach(btn => {
            btn.addEventListener('click', () => {
                const billerId = btn.dataset.billerId;
                const ref      = btn.dataset.billerRef ?? '';
                document.getElementById('billerSelect').value = billerId;
                document.getElementById('billerRef').value    = ref;
                document.getElementById('amountInput').focus();
                // visual feedback
                document.querySelectorAll('.saved-biller-item').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });

        const amountInput = document.getElementById('amountInput');
        const feeHint     = document.getElementById('feeHint');
        const feeVal      = document.getElementById('feeHintValue');
        const twoFaHint   = document.getElementById('twoFaHint');

        amountInput.addEventListener('input', () => {
            const amount = parseFloat(amountInput.value) || 0;
            if (amount <= 0) { feeHint.style.display = 'none'; return; }

            const fee = amount <= 100 ? 0.50 : 1.00;
            feeVal.textContent    = '$' + fee.toFixed(2);
            feeHint.style.display = '';
            twoFaHint.style.display = amount >= 1000 ? '' : 'none';
        });
    </script>
}
