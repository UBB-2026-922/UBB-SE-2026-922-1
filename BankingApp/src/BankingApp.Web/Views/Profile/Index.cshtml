@model BankingApp.Web.ViewModels.Profile.ProfileIndexViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-person-circle me-2 text-primary"></i>Profile & Settings</h1>
    <p class="page-subtitle">Manage your personal information, security settings, and preferences.</p>
</div>

<div class="row g-4">
    <!-- Personal Info Card -->
    <div class="col-md-6">
        <a asp-action="PersonalInfo" class="text-decoration-none">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-square bg-primary-subtle text-primary rounded-circle me-3">
                            <i class="bi bi-person fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0 text-dark">Personal Information</h5>
                    </div>
                    <p class="card-text text-muted">View and edit your full name, phone number, and other personal details.</p>
                    
                    <div class="mt-3 small text-muted-sm border-top pt-3">
                        <div><strong>Name:</strong> @Model.FullName</div>
                        <div><strong>Email:</strong> @Model.Email</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Security Card -->
    <div class="col-md-6">
        <a href="#" class="text-decoration-none">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-square bg-warning-subtle text-warning rounded-circle me-3">
                            <i class="bi bi-shield-lock fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0 text-dark">Security</h5>
                    </div>
                    <p class="card-text text-muted">Change your password and manage two-factor authentication.</p>
                    
                    <div class="mt-3 small text-muted-sm border-top pt-3">
                        <div class="d-flex align-items-center">
                            <span class="me-2">2FA Status:</span>
                            @if (Model.Is2FaEnabled)
                            {
                                <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill"><i class="bi bi-dash-circle me-1"></i>Disabled</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Sessions Card -->
    <div class="col-md-6">
        <a href="#" class="text-decoration-none">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-square bg-info-subtle text-info rounded-circle me-3">
                            <i class="bi bi-laptop fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0 text-dark">Active Sessions</h5>
                    </div>
                    <p class="card-text text-muted">View devices currently logged into your account and revoke access.</p>
                </div>
            </div>
        </a>
    </div>

    <!-- Notifications Card -->
    <div class="col-md-6">
        <a href="#" class="text-decoration-none">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-square bg-success-subtle text-success rounded-circle me-3">
                            <i class="bi bi-bell fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0 text-dark">Notifications</h5>
                    </div>
                    <p class="card-text text-muted">Choose how you want to be notified about account activity and transfers.</p>
                </div>
            </div>
        </a>
    </div>
</div>
