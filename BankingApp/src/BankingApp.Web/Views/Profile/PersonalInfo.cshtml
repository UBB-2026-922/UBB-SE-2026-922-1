@model BankingApp.Web.ViewModels.Profile.PersonalInfoViewModel
@{
    ViewData["Title"] = "Personal Information";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-person me-2 text-primary"></i>Personal Information</h1>
        <p class="page-subtitle">Update your personal details here.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Profile
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary"></i>
                <span>Edit Details</span>
            </div>
            <div class="card-body">
                
                <form asp-action="PersonalInfo" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Email (Read-only) -->
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope me-1"></i>Email Address
                        </label>
                        <input asp-for="Email" class="form-control" readonly disabled />
                        <div class="form-text text-muted small"><i class="bi bi-info-circle me-1"></i>Email address cannot be changed.</div>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person-badge me-1"></i>Full Name
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                        <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-group mb-4">
                        <label asp-for="PhoneNumber" class="form-label">
                            <i class="bi bi-telephone me-1"></i>Phone Number
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter your phone number" />
                        <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="divider"></div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
