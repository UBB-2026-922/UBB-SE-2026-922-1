@model BankingApp.Web.ViewModels.Profile.NotificationsViewModel
@{
    ViewData["Title"] = "Notification Preferences";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-bell me-2 text-primary"></i>Notification Preferences</h1>
    <p class="page-subtitle">Choose which notifications you want to receive and how.</p>
</div>

@if (!Model.Preferences.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell-slash fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No notification categories available</h5>
            <p class="text-muted mb-0">Notification preferences could not be loaded at this time.</p>
        </div>
    </div>
}
else
{
    <form asp-action="Notifications" method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-sliders text-primary"></i>
                <span>Preferences by Category</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="notificationPreferencesTable">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th class="text-center">Push</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">SMS</th>
                                <th>Min. Amount Threshold</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Preferences.Count; i++)
                            {
                                <input type="hidden" asp-for="Preferences[i].Category" />
                                <input type="hidden" asp-for="Preferences[i].CategoryDisplayName" />

                                <tr>
                                    <td class="fw-medium align-middle">
                                        <i class="bi @Model.Preferences[i].CategoryIcon me-2 text-primary"></i>
                                        @Model.Preferences[i].CategoryDisplayName
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="form-check form-switch d-inline-block mb-0">
                                            <input asp-for="Preferences[i].PushEnabled"
                                                   class="form-check-input"
                                                   type="checkbox" />
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="form-check form-switch d-inline-block mb-0">
                                            <input asp-for="Preferences[i].EmailEnabled"
                                                   class="form-check-input"
                                                   type="checkbox" />
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="form-check form-switch d-inline-block mb-0">
                                            <input asp-for="Preferences[i].SmsEnabled"
                                                   class="form-check-input"
                                                   type="checkbox" />
                                        </div>
                                    </td>
                                    <td class="align-middle" style="max-width: 180px;">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="Preferences[i].MinAmountThreshold"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control form-control-sm"
                                                   placeholder="—" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted-sm">@Model.Preferences.Count category(ies)</span>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save Preferences
                </button>
            </div>
        </div>
    </form>
}
