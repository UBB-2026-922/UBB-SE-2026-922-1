@model BankingApp.Web.ViewModels.Cards.CardListViewModel
@{
    ViewData["Title"] = "Cards";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-credit-card me-2 text-primary"></i>Cards</h1>
        <p class="page-subtitle">Manage your debit and credit cards.</p>
    </div>
    <a asp-action="Issue" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Issue New Card
    </a>
</div>

@if (!Model.HasCards)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-credit-card fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No cards yet</h5>
            <p class="text-muted mb-4">Issue your first card to start making payments.</p>
            <a asp-action="Issue" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Issue New Card
            </a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Card Number</th>
                            <th>CVV</th>
                            <th>Cardholder</th>
                            <th>Brand / Type</th>
                            <th>Account</th>
                            <th>Expires</th>
                            <th class="text-center">Contactless</th>
                            <th class="text-center">Online</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (BankingApp.Web.ViewModels.Cards.CardRowViewModel row in Model.Cards)
                        {
                            <tr>
                                <td class="font-monospace">
                                    <span id="card-number-@row.Id"
                                          data-masked="@row.CardNumber"
                                          data-full="@row.FullCardNumber">@row.CardNumber</span>
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 ms-1 card-reveal-btn"
                                            data-span-id="card-number-@row.Id"
                                            title="Reveal card number"
                                            aria-label="Reveal card number">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                                <td class="font-monospace">
                                    <span id="card-cvv-@row.Id"
                                          data-masked="•••"
                                          data-full="@row.SecurityCode">•••</span>
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 ms-1 card-reveal-btn"
                                            data-span-id="card-cvv-@row.Id"
                                            title="Reveal CVV"
                                            aria-label="Reveal CVV">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                                <td>@row.CardholderName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(row.CardBrand))
                                    {
                                        <span class="fw-medium">@row.CardBrand</span>
                                        <span class="text-muted-sm ms-1">·</span>
                                    }
                                    <span class="text-muted-sm">@row.CardType</span>
                                </td>
                                <td class="text-muted-sm">@(row.AccountName ?? "—")</td>
                                <td class="text-muted-sm">@row.ExpiryDate.ToString("MM/yyyy")</td>
                                <td class="text-center">
                                    @if (row.IsContactlessEnabled)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Enabled"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted" title="Disabled"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (row.IsOnlineEnabled)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Enabled"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted" title="Disabled"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @row.StatusBadgeClass">@row.Status</span>
                                </td>
                                <td class="text-center" style="white-space:nowrap">
                                    @if (row.CanFreeze)
                                    {
                                        <form asp-action="Freeze" asp-route-id="@row.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning me-1"
                                                    title="Freeze card"
                                                    onclick="return confirm('Freeze this card?');">
                                                <i class="bi bi-snow"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (row.CanUnfreeze)
                                    {
                                        <form asp-action="Unfreeze" asp-route-id="@row.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success me-1"
                                                    title="Unfreeze card"
                                                    onclick="return confirm('Unfreeze this card?');">
                                                <i class="bi bi-sun"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (row.CanCancel)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@row.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Cancel card"
                                                    onclick="return confirm('Permanently cancel this card? This action cannot be undone.');">
                                                <i class="bi bi-x-octagon"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted-sm">@Model.Cards.Count card(s)</span>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.card-reveal-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var spanId = btn.getAttribute('data-span-id');
                    var span = document.getElementById(spanId);
                    var icon = btn.querySelector('i');
                    var isRevealed = span.getAttribute('data-revealed') === 'true';

                    if (isRevealed) {
                        span.textContent = span.getAttribute('data-masked');
                        span.setAttribute('data-revealed', 'false');
                        icon.classList.replace('bi-eye-slash', 'bi-eye');
                        btn.title = btn.title.replace('Hide', 'Reveal');
                    } else {
                        span.textContent = span.getAttribute('data-full');
                        span.setAttribute('data-revealed', 'true');
                        icon.classList.replace('bi-eye', 'bi-eye-slash');
                        btn.title = btn.title.replace('Reveal', 'Hide');
                    }
                });
            });
        })();
    </script>
}
