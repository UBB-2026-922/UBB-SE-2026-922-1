@model BankingApp.Web.ViewModels.RateAlerts.CreateRateAlertViewModel
@{
    ViewData["Title"] = "Create Rate Alert";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-bell-fill me-2 text-primary"></i>Create Rate Alert</h1>
    <p class="page-subtitle">Set up a notification for when a currency pair reaches your target rate.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle text-primary"></i>
                <span>Alert Details</span>
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Base Currency -->
                    <div class="form-group">
                        <label asp-for="BaseCurrency" class="form-label">
                            <i class="bi bi-cash-stack me-1"></i>From Currency
                        </label>
                        <select asp-for="BaseCurrency" class="form-select" id="baseCurrencySelect">
                            <option value="">— Select currency —</option>
                            @foreach (var currency in BankingApp.Web.ViewModels.RateAlerts.CreateRateAlertViewModel.SupportedCurrencies)
                            {
                                <option value="@currency">@currency</option>
                            }
                        </select>
                        <span asp-validation-for="BaseCurrency" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Target Currency -->
                    <div class="form-group">
                        <label asp-for="TargetCurrency" class="form-label">
                            <i class="bi bi-cash-stack me-1"></i>To Currency
                        </label>
                        <select asp-for="TargetCurrency" class="form-select" id="targetCurrencySelect">
                            <option value="">— Select currency —</option>
                            @foreach (var currency in BankingApp.Web.ViewModels.RateAlerts.CreateRateAlertViewModel.SupportedCurrencies)
                            {
                                <option value="@currency">@currency</option>
                            }
                        </select>
                        <span asp-validation-for="TargetCurrency" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Target Rate -->
                    <div class="form-group">
                        <label asp-for="TargetRate" class="form-label">
                            <i class="bi bi-graph-up-arrow me-1"></i>Target Rate
                        </label>
                        <input asp-for="TargetRate"
                               type="number"
                               step="0.000001"
                               min="0.000001"
                               class="form-control"
                               id="targetRateInput"
                               placeholder="e.g. 1.085000" />
                        <span asp-validation-for="TargetRate" class="invalid-feedback d-block"></span>
                    </div>

                    <!-- Direction -->
                    <div class="form-group">
                        <label asp-for="IsBuyAlert" class="form-label">
                            <i class="bi bi-arrow-up-down me-1"></i>Direction
                        </label>
                        <select asp-for="IsBuyAlert" class="form-select" id="directionSelect">
                            <option value="true">Above — notify when rate goes above target</option>
                            <option value="false">Below — notify when rate goes below target</option>
                        </select>
                        <span asp-validation-for="IsBuyAlert" class="invalid-feedback d-block"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="divider"></div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-bell me-2"></i>Create Alert
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
