@{
    ViewData["Title"] = "Invalid reset link";
}

<div class="row justify-content-center">
    <div class="col-sm-8 col-md-6 col-lg-5 col-xl-4 text-center">

        <div class="page-header">
            <i class="bi bi-exclamation-circle fs-1 text-danger"></i>
            <h1 class="page-title mt-3">Link expired or invalid</h1>
            <p class="page-subtitle">
                This password reset link is invalid or has already been used.
                Please request a new one.
            </p>
        </div>

        <a asp-controller="PasswordReset" asp-action="ForgotPassword" class="btn btn-primary">
            <i class="bi bi-envelope me-1"></i>Request a new reset link
        </a>

    </div>
</div>
