@model BankingApp.Web.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-2">Two-factor verification</h2>
        <p class="text-muted mb-4">
            Enter the 6-digit code sent to your email. The code expires in 10 minutes.
        </p>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        <form asp-action="VerifyOtp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="OtpCode" class="form-label"></label>
                <input asp-for="OtpCode"
                       class="form-control form-control-lg text-center"
                       maxlength="6"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       placeholder="000000" />
                <span asp-validation-for="OtpCode" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Verify</button>
        </form>

        <form asp-action="ResendOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.UserId" />
            <button type="submit" class="btn btn-link w-100">Resend code</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}