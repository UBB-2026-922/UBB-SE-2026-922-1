<Page
    x:Class="BankingApp.Desktop.Views.TransferHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BankingApp.Desktop.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Transfer History"
                       FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Button Content="Refresh"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Error InfoBar -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Margin="0,0,0,12" />

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="2"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,16" />

        <!-- Empty-state placeholder -->
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasNoTransfers, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="#BDBDBD" />
            <TextBlock Text="No transfers yet"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#9E9E9E"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Your completed transfers will appear here."
                       FontSize="14" Foreground="#BDBDBD"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Transfer list -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferHistoryDisplayItem">
                    <Border Padding="16,12" Margin="0,3"
                            Background="White"
                            BorderBrush="#E8ECF0" BorderThickness="1"
                            CornerRadius="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: recipient, IBAN, status, date -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{x:Bind RecipientName}"
                                           FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind RecipientIban}"
                                           Foreground="#666" FontSize="12"
                                           FontFamily="Consolas" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind StatusDisplay}"
                                               Foreground="#555" FontSize="12" />
                                    <TextBlock Text="·" Foreground="#BBB" FontSize="12" />
                                    <TextBlock Text="{x:Bind DateDisplay}"
                                               Foreground="#888" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: amount and reference -->
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{x:Bind AmountDisplay}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#C62828"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ReferenceDisplay}"
                                           FontSize="11" Foreground="#999"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
