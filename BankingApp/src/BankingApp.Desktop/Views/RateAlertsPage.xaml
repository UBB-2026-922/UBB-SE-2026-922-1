<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="BankingApp.Desktop.Views.RateAlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    x:Name="RootPage">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Rate Alerts"
                           FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button Content="Refresh"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- Alerts list -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Alerts}"
                  SelectionMode="None"
                  Margin="0,0,0,16">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding BaseCurrency}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="➔" VerticalAlignment="Center" Foreground="Gray" />
                            <TextBlock Grid.Column="2" Text="{Binding TargetCurrency}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding TargetRate}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="Bold">
                                <Run Text="BUY" x:Name="BuyLabel" />
                            </TextBlock>

                            <Border Grid.Column="5" Background="#44FF0000" CornerRadius="4" Padding="8,4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="TRIGGERED" Foreground="Red" FontWeight="Bold" FontSize="12" />
                            </Border>

                            <Button Grid.Column="6" Content="Delete"
                                    Click="DeleteAlertButton_Click"
                                    Tag="{Binding Id}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Create new alert form -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
            <ComboBox Header="Base Currency"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding BaseCurrency, Mode=TwoWay}"
                      Width="150" />

            <ComboBox Header="Target Currency"
                      ItemsSource="{Binding AvailableCurrencies}"
                      SelectedItem="{Binding TargetCurrency, Mode=TwoWay}"
                      Width="150" />

            <TextBox Header="Target Rate"
                     Text="{Binding TargetRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="e.g. 1.05" Width="150" />

            <ComboBox Header="Alert Type"
                      SelectedValue="{Binding IsBuyAlert, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      Width="150">

                <ComboBoxItem Content="Sell">
                    <ComboBoxItem.Tag>
                        <x:Boolean>false</x:Boolean>
                    </ComboBoxItem.Tag>
                </ComboBoxItem>

                <ComboBoxItem Content="Buy">
                    <ComboBoxItem.Tag>
                        <x:Boolean>true</x:Boolean>
                    </ComboBoxItem.Tag>
                </ComboBoxItem>

            </ComboBox>

            <Button Content="Create Alert"
                    Click="CreateAlertButton_Click"
                    VerticalAlignment="Bottom" />
        </StackPanel>

        <!-- Error message -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Page>